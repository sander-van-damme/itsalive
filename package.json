{
  "name": "living-apps-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.root.config.ts",
    "dev:app": "vite --config vite.app.config.ts",
    "build": "npm run build:root && npm run build:app",
    "build:root": "vite build --config vite.root.config.ts",
    "build:app": "vite build --config vite.app.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview --config vite.root.config.ts"
  },
  "dependencies": {
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.3",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
