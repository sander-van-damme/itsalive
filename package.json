{
  "name": "itsalive",
  "version": "2.0.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.root.config.ts",
    "dev:app": "vite --config vite.app.config.ts",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build": "npm run build:runtime && vite build --config vite.root.config.ts && vite build --config vite.app.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "playwright test e2e/benchmark.spec.ts",
    "predev": "npm run build:runtime",
    "pretypecheck": "npm run build:runtime",
    "test:live": "node scripts/live-provider.mjs",
    "format": "prettier --write src tests e2e scripts sites *.ts *.json docs README.md AGENTS.md",
    "test:production": "npm run build && node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@swc/wasm-web": "1.15.3",
    "esbuild-wasm": "0.25.12",
    "idb": "8.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-refresh": "0.18.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/react-refresh": "0.14.3",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
